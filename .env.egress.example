# Э10.1 — переменные для ВТОРОЙ машины (LiveKit Egress).
# Скопировать в .env.egress рядом с docker-compose.egress.yml НА ВТОРОЙ
# МАШИНЕ. Секреты в git не коммитим — здесь только пример.

# Тот же ключ/секрет, что LIVEKIT_API_KEY/LIVEKIT_API_SECRET на основной
# машине (egress входит в кластер как доверенный сервис).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-same-as-main-machine

# Приватный IP основной машины в подсети провайдера (Hetzner vSwitch /
# DO VPC / …). НЕ публичный адрес и НЕ домен. egress ходит сюда за Redis
# (:6379) и LiveKit (:7880).
MAIN_HOST_PRIVATE_IP=10.0.0.2

# Точка монтирования каталога ассетов основной машины на этой машине
# (сетевая ФС провайдера). Должна совпадать по содержимому с STORAGE_ROOT
# на основной машине, иначе API не найдёт готовый файл записи.
EGRESS_STORAGE_ROOT=/data/assets
