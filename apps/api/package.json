{
  "name": "@school/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "seed:material": "tsx --env-file=.env src/db/seed-material.ts",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.3.0",
    "@hocuspocus/server": "^4.6.0",
    "@school/shared": "workspace:*",
    "@sentry/node": "^8.47.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.2",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fractional-indexing": "^3.2.0",
    "ioredis": "^6.0.0",
    "jose": "^5.9.6",
    "livekit-server-sdk": "^2.18.0",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.33.5",
    "yjs": "^13.6.32",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
