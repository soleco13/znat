NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://school:school@localhost:5432/school_dev
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-plus-character-secret
# Э12.4 — подпись гостевого JWT ученика (вход по ссылке /j/:token).
JWT_GUEST_SECRET=change-me-to-yet-another-random-32-plus-character-secret
# Срок жизни гостевой сессии урока в часах (по умолчанию 6, без refresh).
GUEST_SESSION_TTL_HOURS=6
# Э10.6 — подпись recorder-токена (шаблон записи /egress). Отдельный секрет
# от JWT_GUEST_SECRET/JWT_ACCESS_SECRET.
JWT_RECORDER_SECRET=change-me-to-yet-another-random-32-plus-character-secret
COOKIE_SECRET=change-me-to-a-random-32-plus-character-secret
STORAGE_ROOT=./data/assets
STORAGE_HMAC_SECRET=change-me-to-a-random-32-plus-character-secret
PUBLIC_ORIGIN=http://localhost:3000

# LiveKit (Э2). LIVEKIT_URL — адрес для СЕРВЕРА (генерация токенов, вебхуки,
# RoomServiceClient); в docker-compose переопределяется на host.docker.internal,
# т.к. livekit слушает в network_mode: host, а не в bridge-сети контейнеров.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-random-32-plus-character-secret
# Публичный адрес для БРАУЗЕРА. Локально — прямой порт хоста; на проде —
# wss://<домен>/rtc (Caddy проксирует /rtc/* на localhost:7880, см. Caddyfile.prod).
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# TURN (coturn, §3.2/§10.5 ТЗ). Секрет общий между coturn и livekit.yaml —
# livekit подписывает им временные TURN-креды для каждого участника.
TURN_DOMAIN=localhost
TURN_SHARED_SECRET=change-me-to-a-random-32-plus-character-secret

# Э14.1 — собственный SMTP-релей для писем подтверждения почты (self-signup).
# На проде: реальный релей с настроенными SPF/DKIM/DMARC для SMTP_FROM.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=no-reply@localhost
