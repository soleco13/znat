{
  "title": "App overview",
  "uid": "school-app-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "App up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"app\"}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency (s), гейт < 0.2",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "RAM процесса app (bytes), гейт < 1 ГБ",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"app\"}", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(http_request_duration_seconds_count[5m])) by (status_code)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Трафик по урокам (Мбит/с, расчёт — Э6.5/Э6.6, §5.2 ТЗ)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum(lesson_traffic_mbit) by (lesson_id, mode)", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Суммарный трафик платформы (Мбит/с), алерт > 600",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "sum(lesson_traffic_mbit)", "refId": "A" }]
    }
  ]
}
