{
  "name": "school-platform",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r run typecheck",
    "depcheck": "dependency-cruiser --config .dependency-cruiser.cjs apps/api/src apps/web/src packages/shared/src",
    "db:migrate": "pnpm --filter @school/api run db:migrate"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2", "esbuild", "sharp"]
  }
}
