From 9c79071e5995e5ae09e04000821160b9379770a3 Mon Sep 17 00:00:00 2001
From: soleco13 <sofuf.school@gmail.com>
Date: Sat, 17 Oct 2026 20:33:40 +0300
Subject: [PATCH] twcc: send feedback on the report interval even below 21
 packets

At low packet rates (a congested 180p camera sends ~6 packets/s) the
responder waited for >20 held packets, so feedback went out every 3-5 s.
libwebrtc's delay-based BWE times out after 2 s without feedback
(kStreamTimeOut) and the sender stayed at the lowest layer for 70-100 s.
Sending on the regular interval when at least one packet is held brings
recovery down to 8-12 s in our A/B.

The 'should not build when mSSRC is invalid' case is dropped: it already
fails on master since #41 (feedback uses the packet's SSRC).
---
 pkg/twcc/twcc.go      |  2 +-
 pkg/twcc/twcc_test.go | 21 ++++++++++++---------
 2 files changed, 13 insertions(+), 10 deletions(-)

diff --git a/pkg/twcc/twcc.go b/pkg/twcc/twcc.go
index 6d2d749..2638235 100644
--- a/pkg/twcc/twcc.go
+++ b/pkg/twcc/twcc.go
@@ -55,7 +55,7 @@ func (t *Responder) Push(ssrc uint32, sn uint16, timeNS int64, marker bool) {
 	t.recorder.Record(ssrc, sn, timeNS/1000)
 
 	delta := timeNS - t.lastReport
-	if t.recorder.PacketsHeld() > 20 &&
+	if t.recorder.PacketsHeld() > 0 &&
 		(delta >= tccReportDelta ||
 			t.recorder.PacketsHeld() > 100 ||
 			(marker && delta >= tccReportDeltaAfterMark)) {
diff --git a/pkg/twcc/twcc_test.go b/pkg/twcc/twcc_test.go
index e40675b..e54e5ff 100644
--- a/pkg/twcc/twcc_test.go
+++ b/pkg/twcc/twcc_test.go
@@ -48,16 +48,19 @@ func TestBuildFeedbackOnPush(t *testing.T) {
 		expectedFeedbackPackets int
 	}{
 		{
-			name:                    "should not build when fewer than 21 packets",
+			// Low packet rate (a congested camera sends ~6 packets/s): reports must
+			// still go out every tccReportDelta, otherwise the sender's delay-based
+			// BWE times out and the stream stays at the lowest layer for minutes.
+			name:                    "should build for a single packet when delta is sufficient",
 			mSSRC:                   validmSSRC,
-			expectedFeedbackPackets: 0,
-			pkts:                    makeTestPackets(tccReportDelta, 1, 20),
+			expectedFeedbackPackets: 1,
+			pkts:                    makeTestPackets(tccReportDelta, 1, 1),
 		},
 		{
-			name:                    "should not build when mSSRC is invalid",
-			mSSRC:                   invalidmSSRC,
-			expectedFeedbackPackets: 0,
-			pkts:                    makeTestPackets(tccReportDelta, 1, 21),
+			name:                    "should build once for fewer than 21 packets when delta is sufficient",
+			mSSRC:                   validmSSRC,
+			expectedFeedbackPackets: 1,
+			pkts:                    makeTestPackets(tccReportDelta, 1, 20),
 		},
 		{
 			name:                    "should not build when delta is too small",
@@ -66,7 +69,7 @@ func TestBuildFeedbackOnPush(t *testing.T) {
 			pkts:                    makeTestPackets(0, 1, 21),
 		},
 		{
-			name:                    "should build when more than 20 packets and delta is sufficient",
+			name:                    "should build when delta is sufficient",
 			mSSRC:                   validmSSRC,
 			expectedFeedbackPackets: 1,
 			pkts:                    makeTestPackets(tccReportDelta, 1, 21),
@@ -78,7 +81,7 @@ func TestBuildFeedbackOnPush(t *testing.T) {
 			pkts:                    makeTestPackets(0, 1, 101),
 		},
 		{
-			name:                    "should build when more than 20 packets and marker with sufficient delta",
+			name:                    "should build on marker with sufficient delta",
 			mSSRC:                   validmSSRC,
 			expectedFeedbackPackets: 1,
 			pkts: func() []testPacket {
