diff -ruN pa/pkg/sfu/streamallocator/streamallocator.go pb/pkg/sfu/streamallocator/streamallocator.go
--- a/pkg/sfu/streamallocator/streamallocator.go	2026-10-14 16:22:15.595182255 +0300
+++ b/pkg/sfu/streamallocator/streamallocator.go	2026-10-14 16:22:15.609043578 +0300
@@ -812,6 +812,23 @@
 		}
 	}
 
+	// Матис: проба повторяет последние пакеты видео (RTX), но у дорожки,
+	// которая давно на паузе, их уже нет в буфере — проба уходила пустой
+	// (PacketsProbe: 0), оценка канала оставалась на десятках кбит/с, и
+	// видео не возвращалось до перезахода, хотя сеть давно восстановилась
+	// (стенд 2026-10-14, провал канала до 120 кбит/с на 30 с). Недостающее
+	// добираем заглушками, как Jitsi Videobridge (ProbingDataSender.sendDummyData).
+	if bytesToSend > 0 {
+		for _, track := range s.getVideoTracks() {
+			sent := track.WriteProbePadding(bytesToSend)
+			bytesSent += sent
+			bytesToSend -= sent
+			if bytesToSend <= 0 {
+				break
+			}
+		}
+	}
+
 	s.prober.ProbesSent(bytesSent)
 }
 
diff -ruN pa/pkg/sfu/streamallocator/track.go pb/pkg/sfu/streamallocator/track.go
--- a/pkg/sfu/streamallocator/track.go	2026-10-14 16:22:15.595260108 +0300
+++ b/pkg/sfu/streamallocator/track.go	2026-10-14 16:22:15.608713039 +0300
@@ -138,6 +138,12 @@
 	return t.downTrack.WriteProbePackets(bytesToSend, false)
 }
 
+// WriteProbePadding — проба пакетами-заглушками (RTX без медиа), когда
+// повторять нечего (Матис, см. handleSignalSendProbe).
+func (t *Track) WriteProbePadding(bytesToSend int) int {
+	return t.downTrack.WriteProbePackets(bytesToSend, true)
+}
+
 func (t *Track) AllocateOptimal(allowOvershoot bool, hold bool) sfu.VideoAllocation {
 	return t.downTrack.AllocateOptimal(allowOvershoot, hold)
 }
