# Клиенты (curl, браузеры) обычно не отправляют SNI при подключении по IP-
# литералу — без этой опции Caddy не может выбрать сертификат для такого
# handshake и роняет соединение (TLS alert: internal error).
{
	default_sni 213.21.241.28
}

# Защитные заголовки. CSP для страниц приложения: скрипты только свои —
# даже если в страницу попадёт чужая разметка, её скрипт не выполнится и не
# доберётся до /auth/refresh. Лендинг (свой inline-скрипт) CSP не получает.
# /files/* — пользовательские файлы: sandbox и никаких скриптов, чтобы
# загруженный документ не мог работать от имени нашего домена.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@app_pages not path / /landing/* /files/*
	header @app_pages Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
	@user_files path /files/*
	header @user_files Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
}

# Файлы /files/* (слайды, картинки, MP4 записей) отдаёт Caddy, а не Node:
# приложение проверяет HMAC-подпись ссылки и отвечает пустым телом с
# заголовком X-Accel-Redirect (FILES_VIA_PROXY=true), Caddy берёт файл с
# того же тома хранилища (read-only). Поддерживает Range — перемотка видео.
# Заголовок видит только Caddy: клиент подставить его не может, это ответ
# upstream, а не запрос.
(app_proxy) {
	import security_headers

	reverse_proxy app:3000 {
		@accel header X-Accel-Redirect *
		handle_response @accel {
			root * /srv/files
			rewrite * {rp.header.X-Accel-Redirect}
			file_server
		}
	}
	encode gzip

	@files path /files/*
	header @files Cache-Control "private, max-age=3600"
}

# Локальная разработка (docker-compose up): без TLS, без домена.
# Продовый конфиг с доменом и Let's Encrypt — Caddyfile.prod (Э0.8, деплой на боевой сервер).
:80 {
	# /metrics — только для Prometheus внутри docker-сети (app:3000/metrics
	# напрямую, минуя Caddy); наружу закрыт, как в Caddyfile.prod.
	@metrics path /metrics
	respond @metrics 404

	# Лендинг — см. подробный комментарий в https-блоке ниже, тот же приём.
	handle / {
		root * /srv/landing
		file_server
	}
	handle_path /landing/* {
		root * /srv/landing
		file_server
	}

	import app_proxy
}

# Тестовый доступ по IP без домена: самоподписанный сертификат Caddy (internal CA).
# Браузеры и Web API (Clipboard, crypto.randomUUID) требуют secure context —
# без HTTPS они молча не работают даже на http://<ip>. Сертификат недоверенный,
# браузер один раз попросит подтвердить исключение.
https://213.21.241.28 {
	tls internal

	# /metrics — только для Prometheus внутри docker-сети (app:3000/metrics
	# напрямую, минуя Caddy); наружу закрыт, как в Caddyfile.prod.
	@metrics path /metrics
	respond @metrics 404

	# LiveKit signaling под тем же сертификатом/портом, что и сайт — livekit-
	# client сам добавляет "/rtc"("/validate") к переданному serverUrl
	# (см. createRtcUrl в livekit-client), так что путь-префикс тут
	# достаточен. Раньше пробовали отдельный порт 7443 под TLS — работает,
	# но браузер требует ВТОРОЕ ручное подтверждение самоподписанного
	# сертификата (для порта 7443 отдельно от 443), что легко пропустить —
	# из-за этого у первого тестировщика не подключались камера/микрофон.
	# Один порт/сертификат — одно подтверждение.
	handle_path /livekit/* {
		reverse_proxy host.docker.internal:7880
	}

	# Лендинг (landing/) — отдельный статический сайт, точно на "/" (раньше
	# этот путь отдавало приложение — RequireAuth+HomeRedirect уводил на
	# /lessons). Раздаётся Caddy напрямую из файлов, а не через app: продающая
	# страница не должна зависеть от доступности Node-процесса приложения.
	# Кнопка «Войти» на лендинге ведёт на /login — этот и все остальные пути
	# приложения (/login, /lessons, /j/:token, /assets/* самого приложения и
	# т.д.) по-прежнему уходят в app ниже, не переезжали.
	#
	# `handle /` матчит ИМЕННО "/" (без звёздочки — точное совпадение, не
	# префикс), поэтому не перехватывает остальные пути. Свой префикс
	# /landing/* — под собственные ассеты лендинга (`vite.config.ts` собирает
	# их с base "/landing/"), чтобы не столкнуться с /assets/* приложения.
	handle / {
		root * /srv/landing
		file_server
	}
	handle_path /landing/* {
		root * /srv/landing
		file_server
	}

	import app_proxy
}
