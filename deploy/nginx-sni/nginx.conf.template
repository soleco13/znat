# TCP 443: один адрес на сайт и TURN/TLS (2026-10-11, вариант B из
# docs/turn-tls-443.md). nginx НЕ расшифровывает TLS — только читает имя
# сервера (SNI) из ClientHello и пробрасывает соединение как есть:
#   ${TURN_DOMAIN}  -> coturn TLS (127.0.0.1:5349), сертификат у coturn;
#   всё остальное  -> Caddy (127.0.0.1:8443): сайт, лендинг, LiveKit /livekit.
# Реальный IP клиента — PROXY protocol (Caddy принимает его только с
# локальных адресов, см. Caddyfile.prod). coturn PROXY protocol не умеет:
# для него заголовок снимает внутренний блок 127.0.0.1:10443.
# Рендерится официальным образом nginx (envsubst из /etc/nginx/templates,
# NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx) — подставляется только переменная TURN_DOMAIN (в map ниже).

worker_processes 2;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 16384;
}

stream {
    log_format sni '$remote_addr [$time_local] $ssl_preread_server_name -> $upstream_addr $status $bytes_sent/$bytes_received ${session_time}s';
    access_log off;

    map $ssl_preread_server_name $sni_upstream {
        ${TURN_DOMAIN}  127.0.0.1:10443;
        default         127.0.0.1:8443;
    }

    server {
        listen 443 reuseport;
        ssl_preread on;
        proxy_pass $sni_upstream;
        proxy_protocol on;
        proxy_connect_timeout 5s;
        # WebSocket урока/доски/LiveKit и TURN/TLS живут весь урок; молчание
        # дольше часа — уже мёртвое соединение.
        proxy_timeout 1h;
    }

    # TURN: снять PROXY protocol и отдать сырой TLS coturn'у.
    server {
        listen 127.0.0.1:10443 proxy_protocol;
        proxy_pass 127.0.0.1:5349;
        proxy_connect_timeout 5s;
        proxy_timeout 1h;
    }
}
