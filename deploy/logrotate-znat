# /etc/logrotate.d/znat — ротация JSON-логов API (LOG_FILE, docker-compose.prod.yml).
# Файл открыт приложением на дозапись — copytruncate, без перезапуска.
# maxsize действует при каждом прогоне: прогон раз в час — deploy/logrotate-znat-hourly.
# Сверху приложение само ограничивает запись в файл (plugins/log-file-sink.ts).
/var/log/znat/*.log {
    daily
    maxsize 200M
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su root root
}
