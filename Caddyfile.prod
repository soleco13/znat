{
	# HTTP/3 (QUIC, UDP 443) выключен: UDP 443 наружу не опубликован
	# (docker-compose.yml публикует только TCP), а Caddy всё равно объявлял
	# браузерам `alt-svc: h3` — лишние попытки через недоступный UDP. Да и на
	# мобильных сетях UDP теряется сильнее TCP (замер 2026-09-26).
	servers {
		protocols h1 h2
	}
}

# Защитные заголовки. CSP для страниц приложения: скрипты только свои —
# даже если в страницу попадёт чужая разметка, её скрипт не выполнится и не
# доберётся до /auth/refresh. Лендинг (свой inline-скрипт) CSP не получает.
# /files/* — пользовательские файлы: sandbox и никаких скриптов, чтобы
# загруженный документ не мог работать от имени нашего домена.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@app_pages not path / /landing/* /files/*
	header @app_pages Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
	@user_files path /files/*
	header @user_files Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
}

# Продовый конфиг (Э0.8). Подставляется на сервере через переменную окружения CADDY_DOMAIN.
# Пример: CADDY_DOMAIN=school.example.ru
{$CADDY_DOMAIN} {
	import security_headers
	# Только по HTTPS: браузер не пойдёт на http:// даже по старой ссылке.
	header Strict-Transport-Security "max-age=31536000"

	# /metrics — только для Prometheus внутри docker-сети (app:3000/metrics
	# напрямую, минуя Caddy). Наружу закрыт защитой в глубину.
	@metrics path /metrics
	respond @metrics 404

	# LiveKit (Э2): signaling WS/HTTP наружу только через /rtc — так медиа-сервер
	# не занимает отдельный публичный порт для сигналинга. Сам медиатрафик
	# (UDP 50000-60000, TURN 3478) идёт мимо Caddy напрямую, см. ufw в
	# scripts/server-setup.sh — Caddy тут ни при чём, WebRTC поверх UDP не
	# проксируется через HTTP-реверс-прокси.
	handle /rtc/* {
		uri strip_prefix /rtc
		# localhost здесь был бы адресом самого контейнера caddy, не хоста —
		# livekit в network_mode: host виден только через шлюз хоста
		# (см. extra_hosts у caddy в docker-compose.yml).
		reverse_proxy host.docker.internal:7880
	}

	# Лендинг на "/" — см. подробный комментарий в тестовом Caddyfile (тот же
	# приём). /login и остальные пути приложения по-прежнему идут в app ниже.
	handle / {
		root * /srv/landing
		file_server
	}
	handle_path /landing/* {
		root * /srv/landing
		file_server
	}

	# Файлы /files/* — Caddy после проверки подписи в приложении, см. тестовый Caddyfile.
	reverse_proxy app:3000 {
		@accel header X-Accel-Redirect *
		handle_response @accel {
			root * /srv/files
			rewrite * {rp.header.X-Accel-Redirect}
			file_server
		}
	}
	encode gzip

	# HMAC-подписанные ссылки на файлы отдаём с длинным кэшем на клиенте —
	# подпись сама по себе уже ограничивает срок жизни ссылки.
	@files path /files/*
	header @files Cache-Control "private, max-age=3600"
}
