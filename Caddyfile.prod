# Продовый конфиг под домен (Э0.8). Подключается docker-compose.prod.yml
# вместо Caddyfile (тот — для работы по голому IP). Переменные окружения
# контейнера caddy (docker-compose.prod.yml, значения из .env):
#   CADDY_DOMAIN — сайт, например matis-edu.ru
#   TURN_DOMAIN  — имя TURN, например turn.matis-edu.ru (сертификат для coturn)
#   ACME_EMAIL   — почта для уведомлений Let's Encrypt
# Сертификаты Let's Encrypt выпускаются автоматически (HTTP-01 на :80,
# TLS-ALPN на :443). DNS (A, без AAAA) на сервер должен смотреть ДО запуска,
# иначе неудачные проверки упрутся в лимиты Let's Encrypt.
{
	email {$ACME_EMAIL}
	# HTTP/3 (QUIC, UDP 443) выключен: UDP 443 занят TURN (nat-правило
	# UDP 443 -> coturn :3478 в /etc/ufw/before.rules), а Caddy всё равно
	# объявлял бы браузерам `alt-svc: h3` — лишние попытки через недоступный
	# UDP. Да и на мобильных сетях UDP теряется сильнее TCP (замер 2026-09-26).
	servers {
		protocols h1 h2
	}
	# TCP 443 снаружи слушает nginx (deploy/nginx-sni, 2026-10-11): по SNI он
	# отдаёт turn.* в coturn, остальное — сюда, на 127.0.0.1:8443 (порт 443
	# контейнера). Реальный IP клиента приходит PROXY protocol'ом — без него
	# все запросы выглядели бы как шлюз Docker, и лимиты запросов «по IP»,
	# логи и посещаемость сломались бы. Принимаем его только от локальных
	# адресов (docker-proxy публикует 127.0.0.1:8443 через шлюз 172.x).
	servers :443 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 127.0.0.1/32 172.16.0.0/12
				fallback_policy reject
			}
			tls
		}
		protocols h1 h2
	}
}

# Защитные заголовки. CSP для страниц приложения: скрипты только свои —
# даже если в страницу попадёт чужая разметка, её скрипт не выполнится и не
# доберётся до /auth/refresh. Лендинг (свой inline-скрипт) CSP не получает.
# /files/* — пользовательские файлы: sandbox и никаких скриптов, чтобы
# загруженный документ не мог работать от имени нашего домена.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@app_pages not path / /landing/* /files/*
	header @app_pages Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
	@user_files path /files/*
	header @user_files Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
}

# Политика статики (аудит веса страниц 2026-10-05):
#  - карты исходников (*.map) наружу не отдаются: в них весь исходник
#    фронтенда с комментариями. Новые сборки их и не публикуют (Dockerfile),
#    правило закрывает и карты прошлых сборок в архиве /assets/.
#  - лендинг: ассеты с хешем в имени — навсегда (immutable), сама страница —
#    всегда перепроверять (иначе после выкладки браузер держал бы старую).
(static_policy) {
	@sourcemaps path *.map
	respond @sourcemaps 404
	@landing_assets path /landing/assets/*
	header @landing_assets Cache-Control "public, max-age=31536000, immutable"
	@landing_page path /
	header @landing_page Cache-Control "no-cache"
}

# Файлы /files/* (слайды, картинки, MP4 записей) отдаёт Caddy, а не Node:
# приложение проверяет HMAC-подпись ссылки и отвечает пустым телом с
# заголовком X-Accel-Redirect (FILES_VIA_PROXY=true), Caddy берёт файл с
# того же тома хранилища (read-only). Поддерживает Range — перемотка видео.
# Заголовок видит только Caddy: клиент подставить его не может, это ответ
# upstream, а не запрос. Один в один с тем же сниппетом в Caddyfile.
(app_proxy) {
	import security_headers
	import static_policy

	reverse_proxy app:3000 {
		@accel header X-Accel-Redirect *
		handle_response @accel {
			root * /srv/files
			rewrite * {rp.header.X-Accel-Redirect}
			file_server
		}
	}
	# zstd — браузерам, которые его понимают (Chrome, Edge, Firefox), gzip —
	# остальным. Brotli на лету штатный Caddy не умеет; статика приложения и
	# лендинга уже лежит brotli-копиями и сюда не пережимается.
	encode zstd gzip

	@files path /files/*
	header @files Cache-Control "private, max-age=3600"
}

{$CADDY_DOMAIN} {
	# Только по HTTPS: браузер не пойдёт на http:// даже по старой ссылке.
	# Включено после проверки выпуска сертификата (2026-10-11): с HSTS ошибка
	# сертификата не обходится кликом, а браузер помнит заголовок год.
	header Strict-Transport-Security "max-age=31536000"

	# /metrics — только для Prometheus внутри docker-сети (app:3000/metrics
	# напрямую, минуя Caddy). Наружу закрыт защитой в глубину.
	@metrics path /metrics
	respond @metrics 404
	# Вебхуки LiveKit приходят напрямую в app (127.0.0.1:3000, livekit на
	# host-сети), снаружи этот путь не нужен: подписанный вебхук вне лимита
	# запросов, и закрытый путь не даёт гонять проверку подписи из интернета.
	@webhooks path /webhooks/*
	respond @webhooks 404

	# LiveKit signaling под тем же сертификатом и портом, что и сайт.
	# Схема как в рабочем Caddyfile: LIVEKIT_PUBLIC_URL=wss://<домен>/livekit,
	# livekit-client сам дописывает /rtc (/rtc/validate) к serverUrl,
	# handle_path срезает /livekit и LiveKit получает свой /rtc.
	# Прежний вариант здесь (handle /rtc/* + uri strip_prefix /rtc) не был
	# проверен и ломал путь: после срезания LiveKit получал бы "/" вместо /rtc.
	# localhost здесь был бы адресом самого контейнера caddy, не хоста —
	# livekit в network_mode: host виден только через шлюз хоста
	# (extra_hosts у caddy в docker-compose.yml).
	handle_path /livekit/* {
		reverse_proxy host.docker.internal:7880
	}

	# Лендинг на "/" — см. подробный комментарий в Caddyfile (тот же приём).
	# `handle /` — точное совпадение, не префикс. /login и остальные пути
	# приложения по-прежнему идут в app ниже.
	handle / {
		root * /srv/landing
		# Рядом с файлами лендинга — brotli-копии (*.br, сборка landing/).
		file_server {
			precompressed br
		}
	}
	handle_path /landing/* {
		root * /srv/landing
		# Рядом с файлами лендинга — brotli-копии (*.br, сборка landing/).
		file_server {
			precompressed br
		}
	}

	import app_proxy
}

# www — только редирект на апекс (один адрес сайта: куки, ссылки /j/<token>).
www.{$CADDY_DOMAIN} {
	redir https://{$CADDY_DOMAIN}{uri} permanent
}

# Имя TURN: сайт нужен только ради сертификата Let's Encrypt для TURNS
# (coturn :5349). Сам coturn его не получает — Caddy хранит ключ 0600 root,
# а coturn работает под nobody: копию в turn-certs/ кладёт и coturn
# перечитывает scripts/turn-cert-sync.sh (таймер). По HTTPS тут ничего нет.
{$TURN_DOMAIN} {
	respond 404
}
