# Для docker-compose: скопировать в .env рядом с docker-compose.yml.
# DATABASE_URL и REDIS_URL сюда не нужны — они заданы в docker-compose.yml
# и указывают на сервисы postgres/redis внутри сети compose.
NODE_ENV=production
PORT=3000
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-plus-character-secret
COOKIE_SECRET=change-me-to-a-random-32-plus-character-secret
STORAGE_HMAC_SECRET=change-me-to-a-random-32-plus-character-secret
PUBLIC_ORIGIN=http://localhost

# Продовый Caddy (Э0.8, используется только вместе с Caddyfile.prod)
CADDY_DOMAIN=school.example.ru

# Мониторинг (Э0.11, только с docker-compose.monitoring.yml)
GLITCHTIP_DSN=
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3001
GLITCHTIP_SECRET_KEY=change-me-to-a-random-50-plus-character-secret
GLITCHTIP_DOMAIN=http://localhost:8091

# Бэкапы (Э0.10, для scripts/backup.sh на сервере)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
