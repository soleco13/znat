# Для docker-compose: скопировать в .env рядом с docker-compose.yml.
# DATABASE_URL и REDIS_URL сюда не нужны — они заданы в docker-compose.yml
# и указывают на сервисы postgres/redis внутри сети compose.
NODE_ENV=production
PORT=3000
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-plus-character-secret
# Э12.4 — подпись гостевого JWT ученика (вход по ссылке /j/:token).
JWT_GUEST_SECRET=change-me-to-yet-another-random-32-plus-character-secret
# Срок жизни гостевой сессии урока в часах (по умолчанию 6, без refresh).
GUEST_SESSION_TTL_HOURS=6
# Э10.6 — подпись recorder-токена (шаблон записи /egress). Отдельный секрет
# от JWT_GUEST_SECRET/JWT_ACCESS_SECRET.
JWT_RECORDER_SECRET=change-me-to-yet-another-random-32-plus-character-secret
COOKIE_SECRET=change-me-to-a-random-32-plus-character-secret
STORAGE_HMAC_SECRET=change-me-to-a-random-32-plus-character-secret
PUBLIC_ORIGIN=http://localhost

# Продовый Caddy (Э0.8, используется только вместе с Caddyfile.prod)
CADDY_DOMAIN=school.example.ru

# Мониторинг (Э0.11, только с docker-compose.monitoring.yml)
GLITCHTIP_DSN=
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3001
GLITCHTIP_SECRET_KEY=change-me-to-a-random-50-plus-character-secret
GLITCHTIP_DOMAIN=http://localhost:8091

# Бэкапы (Э0.10, для scripts/backup.sh на сервере)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# Запись уроков (Э10, §10.4/§10.10 ТЗ). По умолчанию ВЫКЛЮЧЕНА — кнопка
# «Записать урок» показывается как «скоро». Включать RECORDING_ENABLED=true
# только когда поднята вторая машина с egress (docker-compose.egress.yml).
RECORDING_ENABLED=false
# Ретеншн записей в днях: 30 — минимум MVP, 90 — целевой (§10.10 ТЗ).
RECORDING_RETENTION_DAYS=90
# TTL presigned-ссылки на скачивание записи, сек (§10.10 ТЗ: «TTL 1 час»).
RECORDING_URL_TTL_SEC=3600
# Базовый URL кастомного layout-шаблона записи (Э10.2). Пусто → дефолтный
# layout LiveKit. Своё, не с чужого CDN — обычно ${PUBLIC_ORIGIN}/egress.
RECORDING_EGRESS_TEMPLATE_URL=
